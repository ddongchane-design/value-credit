{
  // Cloudflare Worker + Static Assets 설정.
  // Git 연동 배포(Workers Builds)에서 Cloudflare가 이 파일을 읽어 그대로 배포한다.
  "name": "value-credit",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",

    // ★ 이 줄이 비밀번호 게이트의 전부다.
    // false(기본값)이면 /valuation/index.html 같은 정적 파일 요청이 Worker를 건너뛰고
    // 곧바로 서빙된다 — src/index.js 의 인증 코드가 실행조차 되지 않아 사이트가 통째로
    // 공개된다. 실제로 그렇게 배포된 적이 있으므로 절대 지우지 말 것.
    "run_worker_first": true
  }
}
